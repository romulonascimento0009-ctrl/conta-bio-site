# Copie para .env.local e preencha. Nunca versione .env.local.

# Banco: vazio = PGlite local em PGLITE_DIR (desenvolvimento).
# Produção: string de conexão PostgreSQL (ex.: Neon).
DATABASE_URL=
PGLITE_DIR=.data/pglite

# Better Auth. Gere o segredo com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Endereço público da plataforma: Bio Sites em <PUBLIC_URL>/<slug>.
PUBLIC_URL=http://localhost:3000

# Armazenamento local de arquivos (desenvolvimento).
STORAGE_DIR=.data/storage

# IA (Fase 5). Chave da API da Claude: https://platform.claude.com → Settings → API Keys.
# Vazia = recursos de IA desligados. Defina também um limite de gasto na própria conta.
ANTHROPIC_API_KEY=
# Teto mensal de gasto com IA (US$), somando todos os clientes.
AI_MONTHLY_BUDGET_USD=10

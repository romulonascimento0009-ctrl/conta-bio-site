# Produção (Neon + Netlify, D42). Copie para .env.neon (fora do Git) e preencha.
# Passo a passo completo: docs/PLAYBOOK.md. NUNCA compartilhar o .env.neon.

# Neon → projeto → Connect → copiar o link que começa com postgresql://
DATABASE_URL=

# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# Endereço do projeto na Netlify (o mesmo nos dois).
BETTER_AUTH_URL=https://NOME.netlify.app
PUBLIC_URL=https://NOME.netlify.app

# Fotos no Netlify Blobs.
STORAGE_DRIVER=netlify-blobs

# Só para scripts no computador (não vão para a Netlify):
# Netlify → Configuração do projeto → Geral → ID do projeto
NETLIFY_SITE_ID=
# Netlify → avatar → Configurações do usuário → Aplicativos → Tokens de acesso pessoal (validade curta)
NETLIFY_API_TOKEN=
